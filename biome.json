{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!docs", "!**/*.md"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "style": {
        "noDefaultExport": "error",
        "noEnum": "error",
        "noNamespace": "error",
        "noParameterProperties": "error"
      }
    }
  }
}
